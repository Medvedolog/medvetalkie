# Managed by MedveTalkie installer
[Unit]
Description=MedveTalkie loopback-only Web Alpha
After=medvetalkie-core.service
Wants=medvetalkie-core.service

[Service]
Type=simple
User=medvetalkie
Group=medvetalkie
ExecStart=/opt/medvetalkie/current/bin/medvetalkie-web --ipc-socket /run/medvetalkie/control.sock
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
