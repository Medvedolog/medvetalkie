#!/bin/bash
# Generated by screensaver/build-launcher.py. Embedded C SHA256: @SOURCE_SHA256@
# Bjorni GIF supplied by the project owner. No package downloads at runtime.
set -uo pipefail
sync_enabled=1
preview=0
for arg in "$@"; do
    case "$arg" in
        --help)
            cat <<'HELP'
Bjorni screensaver for Orange Pi Zero 3 + MSP2008/ST7789.
Run: bash medvetalkie-screensaver.sh [--spi-mhz 4] [--fps 25] [--bgr] [--no-sync]
Default SPI: 1 MHz. Faster wiring trials: 4, then 8 MHz; return to 1 for artifacts.
MEDVETALKIE_SPI_MHZ and MEDVETALKIE_FPS also set these options (including cron).
Stop: Ctrl+C. No autostart is installed.
Time: system local timezone; HTTPS check at startup and every 15 minutes.
MEDVETALKIE_PROXY defaults to http://192.168.11.100:10880.
MEDVETALKIE_TZ can override the timezone, e.g. Europe/Moscow.
Preview without hardware or clock changes: --preview FILE.ppm --frame SECONDS
HELP
            exit 0 ;;
        --no-sync) sync_enabled=0 ;;
        --preview) preview=1; sync_enabled=0 ;;
    esac
done
if (( ! preview )) && (( EUID != 0 )); then
    echo 'Run as root to access SPI/GPIO and synchronize the clock.' >&2
    exit 1
fi
for tool in cc base64 gzip mktemp; do
    command -v "$tool" >/dev/null || { echo "Missing command: $tool" >&2; exit 1; }
done
if (( sync_enabled )); then
    for tool in curl date awk; do
        command -v "$tool" >/dev/null || { echo "Missing command: $tool" >&2; exit 1; }
    done
fi
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/medvetalkie-saver.XXXXXX") || exit 1
child_pid=''
worker_pid=''
wait_pid=''
cleanup() {
    trap - EXIT INT TERM
    for pid in "$child_pid" "$worker_pid" "$wait_pid"; do
        if [[ -n "$pid" ]]; then kill -TERM "$pid" 2>/dev/null || :; fi
    done
    for pid in "$child_pid" "$worker_pid" "$wait_pid"; do
        if [[ -n "$pid" ]]; then wait "$pid" 2>/dev/null || :; fi
    done
    rm -rf -- "$work_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cat > "$work_dir/screensaver.c" <<'MEDVETALKIE_SOURCE'
@SOURCE@
MEDVETALKIE_SOURCE
if ! base64 --decode <<'MEDVETALKIE_SPRITE_DATA' | gzip --decompress > "$work_dir/bjorni.dat"; then
@ASSET@
MEDVETALKIE_SPRITE_DATA
    echo 'Could not decode the embedded Bjorni animation.' >&2
    exit 1
fi
if ! cc -std=c11 -Wall -Wextra -Werror -O2 "$work_dir/screensaver.c" -lm -o "$work_dir/screensaver"; then
    echo 'Could not compile the screensaver.' >&2
    exit 1
fi
export MEDVETALKIE_SPRITE="$work_dir/bjorni.dat"
export MEDVETALKIE_SYNC_STATUS="$work_dir/time-status"
printf '0\n' > "$MEDVETALKIE_SYNC_STATUS"
proxy_url=${MEDVETALKIE_PROXY-http://192.168.11.100:10880}
sync_clock() {
    local endpoint stamp epoch age
    for endpoint in 'https://www.google.com/generate_204' 'https://www.cloudflare.com/'; do
        curl --fail --silent --show-error --head --location \
            --proto '=https' --proto-redir '=https' \
            --proxy "$proxy_url" --noproxy '' \
            --connect-timeout 3 --max-time 8 \
            --header 'Cache-Control: no-cache' \
            --dump-header "$work_dir/time-headers" --output /dev/null \
            "$endpoint?medvetalkie_time=$(date +%s%N)" 2>/dev/null &
        wait_pid=$!
        if wait "$wait_pid"; then
            wait_pid=''
            # Reset fields on each HTTP header block: ignore CONNECT/redirect dates.
            stamp=$(awk '/^HTTP\//{d=""} tolower($1)=="date:"{sub(/^[^:]+:[[:space:]]*/,"");sub(/\r$/,"");d=$0} END{print d}' "$work_dir/time-headers")
            age=$(awk '/^HTTP\//{a=0} tolower($1)=="age:"{a=$2+0} END{print a+0}' "$work_dir/time-headers")
            [[ -n "$stamp" && "$age" =~ ^[0-9]+$ ]] || continue
            (( age <= 2 )) || continue
            epoch=$(LC_ALL=C date --utc --date="$stamp" +%s 2>/dev/null) || continue
            [[ "$epoch" =~ ^[0-9]{10,11}$ ]] || continue
            if date --utc --set="@$epoch" >/dev/null 2>&1; then
                printf '1\n' > "$MEDVETALKIE_SYNC_STATUS.new"
                mv -- "$MEDVETALKIE_SYNC_STATUS.new" "$MEDVETALKIE_SYNC_STATUS"
                printf '[time] Synchronized: %s\n' "$(date '+%d.%m.%Y %H:%M:%S %Z')"
                return 0
            fi
        fi
        wait_pid=''
    done
    printf '0\n' > "$MEDVETALKIE_SYNC_STATUS.new"
    mv -- "$MEDVETALKIE_SYNC_STATUS.new" "$MEDVETALKIE_SYNC_STATUS"
    echo '[time] HTTPS check failed; displaying local system time (amber LOCAL indicator).' >&2
    return 1
}
if (( sync_enabled )); then
    sync_clock || :
    (
        worker_stop() {
            trap - INT TERM
            if [[ -n "$wait_pid" ]]; then
                kill -TERM "$wait_pid" 2>/dev/null || :
                wait "$wait_pid" 2>/dev/null || :
            fi
            exit 0
        }
        trap worker_stop INT TERM
        while :; do
            sleep 900 &
            wait_pid=$!
            wait "$wait_pid" || exit 0
            wait_pid=''
            sync_clock || :
        done
    ) &
    worker_pid=$!
fi
"$work_dir/screensaver" "$@" &
child_pid=$!
result=0
wait "$child_pid" || result=$?
child_pid=''
exit "$result"
