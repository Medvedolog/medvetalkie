# Managed by MedveTalkie installer
[Unit]
Description=MedveTalkie Russian status dashboard and Bjorni ST7789
After=medvetalkie-status.service
Wants=medvetalkie-status.service
ConditionPathExists=/dev/spidev1.0
# A busy GPIO error must not trigger endless C recompiles and CPU load.
StartLimitIntervalSec=180
StartLimitBurst=2

[Service]
Type=simple
User=root
# No automated eviction of legacy cron processes: skip when SPI is busy.
ExecCondition=/bin/sh /opt/medvetalkie/current/check-display-owner.sh --require-free
ExecStart=/bin/bash /opt/medvetalkie/current/medvetalkie-screensaver.sh --no-sync --spi-mhz 4 --fps 25 --status-file /run/medvetalkie/display.status
Restart=on-failure
RestartSec=15
TimeoutStopSec=8
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
