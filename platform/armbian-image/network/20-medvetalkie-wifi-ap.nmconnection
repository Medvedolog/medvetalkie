[connection]
id=MedveTalkie Wi-Fi AP
uuid=4d8c2a12-1c2b-4b7d-9a10-192168120001
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=100

[802-11-wireless]
mode=ap
ssid=MedveTalkie
band=a
channel=36
powersave=2

[802-11-wireless-security]
key-mgmt=wpa-psk
psk=Medve12345!
psk-flags=0

[ipv4]
method=shared
address1=192.168.12.1/24
never-default=true

[ipv6]
method=ignore
